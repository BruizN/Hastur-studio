---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Hastur Studio | Shopify Architecture & E-commerce Operations en Chile",
  description = "Desarrollo técnico directo y sin intermediarios de tiendas Shopify de alto rendimiento. Arquitectura Liquid limpia, optimización WPO extrema, pasarelas chilenas y blindaje legal SERNAC.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://hastur.studio');
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Bruno Maximiliano Ruiz Nahuelpán - Hastur Studio" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#070908" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon SVG con estética Cyber-Clean Hastur Yellow -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23070908'/%3E%3Cpath d='M8 8h4v16H8zm12 0h4v16h-4zm-8 6h8v4h-8z' fill='%23ffffff'/%3E%3Ccircle cx='25' cy='23' r='2.5' fill='%23ffd60a'/%3E%3C/svg%3E" />

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Hastur Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Tipografías de alta fidelidad técnica (Geist & Geist Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=Geist:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org JSON-LD Estructurado -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Hastur Studio",
      "founder": {
        "@type": "Person",
        "name": "Bruno Maximiliano Ruiz Nahuelpán",
        "taxID": "21592069-0"
      },
      "image": "https://hastur.studio/og-image.jpg",
      "description": "Shopify Architecture & E-commerce Operations. Desarrollo técnico de tiendas Shopify, WPO extremo y pasarelas de pago chilenas.",
      "telephone": "+56987753925",
      "email": "brunoruizn@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "CL",
        "addressRegion": "Región Metropolitana",
        "addressLocality": "Santiago"
      },
      "areaServed": "CL",
      "priceRange": "$$$",
      "knowsAbout": [
        "Shopify Development",
        "Shopify Liquid Engine",
        "Web Performance Optimization (WPO)",
        "Webpay Plus",
        "Mercado Pago Chile",
        "SERNAC Compliance E-commerce",
        "Lioren DTE Facturacion Electronica"
      ]
    })} />
  </head>
  <body class="bg-brand-dark min-h-screen text-slate-200 antialiased selection:bg-brand-accent selection:text-brand-dark font-sans relative overflow-x-hidden">
    <!-- Capa de rejilla técnica continua en fondo -->
    <div class="fixed inset-0 tech-grid pointer-events-none opacity-40 z-0" aria-hidden="true"></div>
    <div class="fixed inset-0 bg-gradient-to-b from-brand-accent/[0.03] via-transparent to-brand-dark/90 pointer-events-none z-0" aria-hidden="true"></div>
    
    <!-- Contenido semántico -->
    <div class="relative z-10 flex min-h-screen flex-col justify-between">
      <slot />
    </div>
  </body>
</html>
