---
import Layout from '../layouts/Layout.astro';

const PHONE_NUMBER = "56987753925";
const WHATSAPP_BASE = `https://wa.me/${PHONE_NUMBER}`;

const WHATSAPP_AUDIT_URL = `${WHATSAPP_BASE}?text=Hola!%20Vi%20tu%20web%20en%20Hastur%20Studio%20y%20me%20gustar%C3%ADa%20una%20auditor%C3%ADa%20t%C3%A9cnica%20de%20mi%20tienda%20Shopify`;
const WHATSAPP_PACK_OPTIMIZACION = `${WHATSAPP_BASE}?text=Hola!%20Me%20interesa%20el%20Pack%20de%20Optimizaci%C3%B3n%20y%20Velocidad%20para%20mi%20tienda%20Shopify.`;
const WHATSAPP_PACK_LLAVE_EN_MANO = `${WHATSAPP_BASE}?text=Hola!%20Me%20gustar%C3%ADa%20cotizar%20el%20desarrollo%20de%20una%20Tienda%20Llave%20en%20Mano%20en%20Shopify.`;
const WHATSAPP_PACK_MODULOS = `${WHATSAPP_BASE}?text=Hola!%20Necesito%20un%20m%C3%B3dulo%20t%C3%A9cnico%20puntual%20en%20mi%20tienda.`;

const EMAIL_CONTACT = "brunoruizn@gmail.com";

const microStack = [
  { name: "Shopify OS 2.0", tag: "ARCHITECTURE" },
  { name: "Código Liquid Nativo", tag: "ZERO BLOAT" },
  { name: "Optimización WPO & WebP", tag: "VELOCIDAD & CRO" },
  { name: "Metacampos & Metaobjetos", tag: "DATA DINÁMICA" },
  { name: "Facturación Lioren DTE", tag: "AUTOMATIZACIÓN SII" },
  { name: "Logística Nacional", tag: "COURIERS & MATRIZ RM/REGIONES" },
  { name: "Pasarelas de Pago", tag: "WEBPAY PLUS & MERCADO PAGO" },
  { name: "SERNAC Compliance", tag: "LEY N° 19.496" }
];
---

<Layout>
  <!-- ========================================================================= -->
  <!-- A. HEADER / NAVBAR FIJA                                                  -->
  <!-- ========================================================================= -->
  <header class="sticky top-4 z-40 w-full px-4 sm:px-6">
    <nav class="mx-auto max-w-5xl rounded-full border border-white/[0.08] bg-brand-dark-surface/85 px-4 sm:px-6 py-2.5 backdrop-blur-md shadow-2xl transition-all duration-300">
      <div class="flex items-center justify-between">
        
        <!-- Logo de marca -->
        <a href="#" class="group flex items-center space-x-2 font-mono text-base font-bold tracking-tight text-white transition-colors">
          <span class="inline-block h-2 w-2 rounded-full bg-brand-accent animate-pulse-subtle"></span>
          <span>HASTUR<span class="text-brand-accent">.studio</span></span>
        </a>

        <!-- Enlaces ancla en desktop -->
        <div class="hidden md:flex items-center space-x-7 text-xs font-mono tracking-wider uppercase text-slate-400">
          <a href="#manifiesto" class="transition-colors hover:text-brand-accent">Manifiesto</a>
          <a href="#soluciones" class="transition-colors hover:text-brand-accent">Soluciones</a>
          <a href="#caso-estudio" class="transition-colors hover:text-brand-accent">Caso de Estudio</a>
        </div>

        <!-- CTA Header -->
        <a
          href={WHATSAPP_AUDIT_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center space-x-2 rounded-full border border-brand-accent/30 bg-brand-accent/[0.08] px-3.5 sm:px-4 py-1.5 text-xs font-mono font-medium text-brand-accent transition-all duration-200 hover:border-brand-accent hover:bg-brand-accent hover:text-brand-dark hover:shadow-neon-glow"
        >
          <span>Auditoría por WhatsApp</span>
          <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
        </a>
      </div>
    </nav>
  </header>

  <!-- ========================================================================= -->
  <!-- B. HERO SECTION (Alto impacto visual)                                    -->
  <!-- ========================================================================= -->
  <section class="relative pt-16 sm:pt-24 pb-16 sm:pb-24 px-4 sm:px-6 max-w-5xl mx-auto w-full">
    <!-- Luz difusa de fondo ambiental -->
    <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-96 h-96 bg-brand-accent/[0.07] blur-[120px] rounded-full pointer-events-none" aria-hidden="true"></div>

    <div class="relative flex flex-col items-start text-left">
      <!-- Badge superior -->
      <div class="inline-flex items-center space-x-2.5 rounded-full border border-brand-accent/20 bg-brand-accent/[0.06] px-3.5 py-1 text-xs font-mono uppercase tracking-wider text-brand-accent mb-6 sm:mb-8 backdrop-blur-sm">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-accent opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-accent"></span>
        </span>
        <span class="font-medium">DESARROLLO TÉCNICO & OPERATIVA E-COMMERCE EN CHILE</span>
      </div>

      <!-- Slogan / H1 -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.12] max-w-4xl">
        Tiendas Shopify más rápidas, con <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-100 to-brand-accent">identidad propia</span> y creadas para vender en serio.
      </h1>

      <!-- Slogan secundario destacado -->
      <p class="mt-4 font-mono text-sm sm:text-base text-brand-accent/90 tracking-wide uppercase">
        "El mercado está inundado de clones. Construyo presencias digitales imposibles de ignorar."
      </p>

      <!-- Bajada en primera persona -->
      <p class="mt-6 text-base sm:text-lg text-slate-400 max-w-3xl leading-relaxed">
        No instalo temas genéricos que hacen que tu tienda se confunda con 10.000 competidores. Como operador activo y desarrollador técnico, construyo arquitecturas Shopify a medida con código Liquid limpio, velocidad de carga instantánea, pasarelas locales integradas y blindaje operativo ante el SERNAC.
      </p>

      <!-- Botón CTA Principal -->
      <div class="mt-8 sm:mt-10 flex flex-col items-start gap-2.5 w-full sm:w-auto">
        <a
          href={WHATSAPP_AUDIT_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative inline-flex items-center justify-center space-x-3 rounded-xl bg-brand-accent px-7 py-4 text-sm font-mono font-bold tracking-wide text-brand-dark transition-all duration-300 hover:bg-brand-accent-hover hover:shadow-neon-glow hover:-translate-y-0.5 active:translate-y-0"
        >
          <span>Solicitar auditoría técnica vía WhatsApp</span>
          <span class="text-lg transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>

        <p class="text-xs font-mono text-slate-400 pl-1">
          ¿Prefieres correo tradicional? Escríbeme a <a href={`mailto:${EMAIL_CONTACT}`} class="text-slate-300 underline decoration-slate-600 underline-offset-4 hover:text-brand-accent hover:decoration-brand-accent transition-colors">{EMAIL_CONTACT}</a>
        </p>
      </div>

      <!-- Micro-stack técnico (Badges) -->
      <div class="mt-12 pt-8 border-t border-white/[0.08] w-full">
        <p class="font-mono text-xs uppercase tracking-widest text-slate-500 mb-4">
          Stack de Operación & Arquitectura
        </p>
        <div class="flex flex-wrap gap-2.5">
          {microStack.map((item) => (
            <div class="inline-flex items-center space-x-2 rounded-lg border border-white/[0.07] bg-brand-dark-card/90 px-3.5 py-1.5 backdrop-blur-sm transition-all duration-200 hover:border-brand-accent/40 hover:bg-brand-dark-cardHover">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-accent"></span>
              <span class="text-xs font-mono font-medium text-slate-200">{item.name}</span>
              <span class="text-[10px] font-mono uppercase text-slate-500 border-l border-white/10 pl-2">{item.tag}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- C. MANIFIESTO / DIFERENCIADOR (Tarjeta destacada)                         -->
  <!-- ========================================================================= -->
  <section id="manifiesto" class="py-16 sm:py-24 px-4 sm:px-6 max-w-5xl mx-auto w-full">
    <div class="relative rounded-3xl border border-brand-accent/25 bg-gradient-to-b from-brand-dark-card to-brand-dark-surface p-7 sm:p-12 backdrop-blur-xl shadow-2xl overflow-hidden">
      
      <!-- Efecto radial en esquina -->
      <div class="absolute -top-24 -right-24 h-64 w-64 rounded-full bg-brand-accent/10 blur-[80px] pointer-events-none" aria-hidden="true"></div>

      <div class="relative z-10">
        <!-- Subtítulo técnico de sección -->
        <div class="inline-flex items-center space-x-2 font-mono text-xs font-semibold uppercase tracking-widest text-brand-accent mb-4">
          <span>[ // MANIFIESTO Y PROPÓSITO OPERATIVO ]</span>
        </div>

        <!-- Encabezado del manifiesto -->
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white leading-tight">
          ¿Prefieres un portafolio con 20 temas idénticos, o una estructura digital con criterio técnico y ventas reales?
        </h2>

        <!-- Cuerpo del manifiesto -->
        <p class="mt-6 text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
          Cualquiera puede instalar una plantilla prefabricada y mover tres bloques en una tarde. Mi trabajo es distinto: opero mi propia infraestructura de comercio electrónico en Chile. Sé exactamente dónde se pierden ventas en conexiones 4G, cómo estructurar metacampos para catálogos complejos, cómo evitar rechazos en pasarelas de pago y cómo configurar una logística que no queme tu margen en fletes cruzados.
        </p>

        <!-- Grilla de contraste de valor: Desarrollo Directo vs Agencia -->
        <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-4 pt-8 border-t border-white/[0.08]">
          <div class="rounded-xl border border-rose-500/20 bg-rose-950/10 p-5">
            <div class="flex items-center space-x-2 text-rose-400 font-mono text-xs uppercase font-semibold mb-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
              <span>El modelo tradicional de agencia</span>
            </div>
            <ul class="space-y-2 text-xs sm:text-sm text-slate-400">
              <li class="flex items-start space-x-2">
                <span class="text-rose-400">×</span>
                <span>Intermediarios ejecutivos de cuenta que no tocan una línea de código.</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-rose-400">×</span>
                <span>Instalación indiscriminada de 15 apps de pago mensual que destruyen la velocidad.</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-rose-400">×</span>
                <span>Desconocimiento total de la logística nacional y problemas de pasarelas con Transbank.</span>
              </li>
            </ul>
          </div>

          <div class="rounded-xl border border-brand-accent/30 bg-brand-accent/[0.04] p-5 shadow-neon-subtle">
            <div class="flex items-center space-x-2 text-brand-accent font-mono text-xs uppercase font-semibold mb-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span>El enfoque Hastur Studio</span>
            </div>
            <ul class="space-y-2 text-xs sm:text-sm text-slate-300">
              <li class="flex items-start space-x-2">
                <span class="text-brand-accent">✓</span>
                <span>Contacto directo con el desarrollador que programa la tienda y entiende el inventario.</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-brand-accent">✓</span>
                <span>Ahorro de $30 a $80 USD/mes: Programo en Liquid nativo lo que otros resuelven pagando apps de $10 USD/mes. Tu tienda carga más rápido y te ahorras mensualidades recurrentes.</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-brand-accent">✓</span>
                <span>Funcionalidad nativa en Liquid y metaobjetos sin costos recurrentes injustificados.</span>
              </li>
              <li class="flex items-start space-x-2">
                <span class="text-brand-accent">✓</span>
                <span>Blindaje SERNAC (Ley 19.496) y calibración fina con couriers en Chile (nacionales o express RM).</span>
              </li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- D. SOLUCIONES EMPAQUETADAS (3 Packs con Productized Services)             -->
  <!-- ========================================================================= -->
  <section id="soluciones" class="py-16 sm:py-24 px-4 sm:px-6 max-w-5xl mx-auto w-full">
    <div class="text-left mb-12">
      <div class="inline-flex items-center space-x-2 font-mono text-xs font-semibold uppercase tracking-widest text-brand-accent mb-3">
        <span>[ // SOLUCIONES EMPAQUETADAS & ALCANCE TÉCNICO ]</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-white">
        Planes transparentes con entrega rápida y precio cerrado.
      </h2>
      <p class="mt-3 text-sm sm:text-base text-slate-400 max-w-2xl">
        Sin cotizaciones infladas, sin tiempos eternos ni costos mensuales recurrentes. Soluciones puntuales diseñadas para generar impacto financiero inmediato.
      </p>
    </div>

    <!-- Grid de 3 Tarjetas de Soluciones Empaquetadas -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch">
      
      <!-- ===================================================================== -->
      <!-- TARJETA 1: Pack Optimización & Velocidad                              -->
      <!-- ===================================================================== -->
      <div class="flex flex-col justify-between rounded-2xl border border-white/[0.08] bg-brand-dark-card/90 p-6 sm:p-7 backdrop-blur-md transition-all duration-300 hover:border-brand-accent/40 hover:bg-brand-dark-cardHover hover:-translate-y-1">
        <div>
          <!-- Badge Superior -->
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="inline-flex items-center space-x-1.5 rounded-full border border-brand-accent/25 bg-brand-accent/[0.07] px-3 py-1 font-mono text-[11px] font-semibold tracking-wider text-brand-accent">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-accent"></span>
              <span>ENTREGA EN 3 A 4 DÍAS HÁBILES</span>
            </span>
            <span class="font-mono text-xs text-slate-500">PACK 01</span>
          </div>

          <!-- Título y Para quién es -->
          <h3 class="text-xl font-bold text-white tracking-tight">
            Pack Optimización & Velocidad
          </h3>
          <p class="mt-2 text-xs sm:text-sm text-slate-400 leading-relaxed min-h-[40px]">
            Para tiendas activas que se sienten lentas, pierden ventas en móviles o necesitan orden técnico.
          </p>

          <!-- Precio Ancla -->
          <div class="my-6 py-4 border-y border-white/[0.06]">
            <span class="text-xs font-mono uppercase tracking-wider text-slate-500 block">Inversión única</span>
            <div class="flex items-baseline space-x-2 mt-1">
              <span class="font-mono text-2xl sm:text-3xl font-bold text-white tracking-tight">Desde $120.000</span>
              <span class="font-mono text-xs text-brand-accent uppercase font-medium">CLP líquidos</span>
            </div>
          </div>

          <!-- Puntos Clave Incluidos -->
          <ul class="space-y-3 text-xs sm:text-[13px] text-slate-300">
            <li class="flex items-start space-x-2.5">
              <span class="text-brand-accent font-bold mt-0.5">✓</span>
              <span>Auditoría técnica y corrección de puntos de fuga de conversión.</span>
            </li>
            <li class="flex items-start space-x-2.5">
              <span class="text-brand-accent font-bold mt-0.5">✓</span>
              <span>Conversión y estandarización completa de imágenes/banners a formato WebP ultraliviano.</span>
            </li>
            <li class="flex items-start space-x-2.5">
              <span class="text-brand-accent font-bold mt-0.5">✓</span>
              <span>Optimización de ficha de producto móvil con Liquid (botones fijos, jerarquía y velocidad).</span>
            </li>
            <li class="flex items-start space-x-2.5">
              <span class="text-brand-accent font-bold mt-0.5">✓</span>
              <span>Purga de código residual y desinstalación de scripts obsoletos.</span>
            </li>
            <li class="flex items-start space-x-2.5">
              <span class="text-brand-accent font-bold mt-0.5">✓</span>
              <span>Blindaje de políticas de cambio y devolución según Ley N° 19.496 (SERNAC).</span>
            </li>
          </ul>
        </div>

        <!-- CTA Botón -->
        <div class="mt-8 pt-4 border-t border-white/[0.06]">
          <a
            href={WHATSAPP_PACK_OPTIMIZACION}
            target="_blank"
            rel="noopener noreferrer"
            class="group w-full inline-flex items-center justify-center space-x-2 rounded-xl border border-brand-accent/40 bg-brand-accent/[0.08] px-4 py-3.5 text-xs font-mono font-bold text-brand-accent transition-all duration-200 hover:border-brand-accent hover:bg-brand-accent hover:text-brand-dark hover:shadow-neon-subtle text-center"
          >
            <span>Consultar Pack Optimización por WhatsApp</span>
            <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
          </a>
        </div>
      </div>

      <!-- ===================================================================== -->
      <!-- TARJETA 2: Tienda Llave en Mano / Reestructuración (SERVICIO ESTRELLA)-->
      <!-- ===================================================================== -->
      <div class="relative flex flex-col justify-between rounded-2xl border-2 border-brand-accent bg-gradient-to-b from-brand-dark-card to-brand-dark-surface p-6 sm:p-7 backdrop-blur-xl shadow-neon-glow lg:-translate-y-2.5 z-20">
        <div>
          <!-- Badge Superior Interno -->
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="inline-flex items-center space-x-1.5 rounded-full border border-brand-accent/40 bg-brand-accent/15 px-3 py-1 font-mono text-[11px] font-semibold tracking-wider text-brand-accent">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-accent animate-ping-slow"></span>
              <span>DESARROLLO EN 10 A 15 DÍAS HÁBILES</span>
            </span>
            <span class="font-mono text-xs text-brand-accent font-bold">PACK 02</span>
          </div>

          <!-- Título y Para quién es -->
          <h3 class="text-xl font-bold text-white tracking-tight">
            Tienda Llave en Mano / Reestructuración Total
          </h3>
          <p class="mt-2 text-xs sm:text-sm text-slate-300 leading-relaxed min-h-[40px]">
            Para marcas que van a lanzar o tiendas que buscan dejar atrás las plantillas genéricas.
          </p>

          <!-- Precio Ancla -->
          <div class="my-6 py-4 border-y border-brand-accent/25 bg-brand-accent/[0.04] -mx-6 sm:-mx-7 px-6 sm:px-7">
            <span class="text-xs font-mono uppercase tracking-wider text-slate-400 block">Arquitectura integral</span>
            <div class="flex items-baseline space-x-2 mt-1">
              <span class="font-mono text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Desde $280.000</span>
              <span class="font-mono text-xs text-brand-accent uppercase font-bold">CLP líquidos</span>
            </div>
            <p class="mt-2 text-[11px] font-mono text-brand-accent/90 leading-tight">
              * Incluye arquitectura base y carga/configuración de hasta 15 productos insignia. Catálogos masivos se cotizan por volumen.
            </p>
          </div>

          <!-- Puntos Clave Incluidos -->
          <ul class="space-y-3 text-xs sm:text-[13px] text-slate-200">
            <li class="flex items-start space-x-2.5">
              <span class="text-brand-accent font-bold mt-0.5">✓</span>
              <span>Arquitectura Shopify desde cero con personalización avanzada en Liquid.</span>
            </li>
            <li class="flex items-start space-x-2.5">
              <span class="text-brand-accent font-bold mt-0.5">✓</span>
              <span><strong class="text-white">Ahorro de $30 a $80 USD/mes en apps innecesarias:</strong> Programo en Liquid nativo lo que otros resuelven pagando apps de $10 USD/mes. Tu tienda carga más rápido y te ahorras mensualidades recurrentes.</span>
            </li>
            <li class="flex items-start space-x-2.5">
              <span class="text-brand-accent font-bold mt-0.5">✓</span>
              <span>Metacampos y metaobjetos dinámicos (tablas de medidas, especificaciones técnicas).</span>
            </li>
            <li class="flex items-start space-x-2.5">
              <span class="text-brand-accent font-bold mt-0.5">✓</span>
              <span>Integración certificada de pasarelas locales (Webpay Plus, Mercado Pago, Flow).</span>
            </li>
            <li class="flex items-start space-x-2.5">
              <span class="text-brand-accent font-bold mt-0.5">✓</span>
              <span>Configuración logística de envíos y zonas (Blue Express, Starken o courier a elección).</span>
            </li>
            <li class="flex items-start space-x-2.5">
              <span class="text-brand-accent font-bold mt-0.5">✓</span>
              <span><strong class="text-white">Facturación automática Lioren DTE:</strong> Emisión automática de boleta al SII por cada venta y despacho del PDF al cliente sin trabajo manual.</span>
            </li>
            <li class="flex items-start space-x-2.5">
              <span class="text-brand-accent font-bold mt-0.5">✓</span>
              <span>Ecosistema de apps esenciales (Judge.me Reviews, Microsoft Clarity, Selleasy, Shopify Messaging).</span>
            </li>
            <li class="flex items-start space-x-2.5">
              <span class="text-brand-accent font-bold mt-0.5">✓</span>
              <span>Correos transaccionales automatizados en HTML/Liquid con identidad de marca.</span>
            </li>
            <li class="flex items-start space-x-2.5">
              <span class="text-brand-accent font-bold mt-0.5">✓</span>
              <span>Entrega con videocápsulas de capacitación para gestión 100% autónoma.</span>
            </li>
          </ul>
        </div>

        <!-- CTA Botón Destacado -->
        <div class="mt-8 pt-4 border-t border-brand-accent/20">
          <a
            href={WHATSAPP_PACK_LLAVE_EN_MANO}
            target="_blank"
            rel="noopener noreferrer"
            class="group w-full inline-flex items-center justify-center space-x-2 rounded-xl bg-brand-accent px-4 py-4 text-xs font-mono font-bold text-brand-dark transition-all duration-300 hover:bg-brand-accent-hover hover:shadow-neon-glow hover:-translate-y-0.5 text-center"
          >
            <span>Cotizar Tienda Llave en Mano</span>
            <span class="text-sm transition-transform duration-200 group-hover:translate-x-1">→</span>
          </a>
        </div>
      </div>

      <!-- ===================================================================== -->
      <!-- TARJETA 3: Módulos Técnicos Específicos                              -->
      <!-- ===================================================================== -->
      <div class="flex flex-col justify-between rounded-2xl border border-white/[0.08] bg-brand-dark-card/90 p-6 sm:p-7 backdrop-blur-md transition-all duration-300 hover:border-brand-accent/40 hover:bg-brand-dark-cardHover hover:-translate-y-1">
        <div>
